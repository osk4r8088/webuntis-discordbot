# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=123456789012345678

# ── WebUntis ─────────────────────────────────────────────
# School name exactly as it appears in WebUntis URL
UNTIS_SCHOOL=your-school-name
# Server hostname, e.g. "neilo.webuntis.com" or "herakles.webuntis.com"
UNTIS_SERVER=neilo.webuntis.com
UNTIS_USERNAME=your-webuntis-username
UNTIS_PASSWORD=your-webuntis-password
# Your class name as shown in WebUntis, e.g. "FI24"
UNTIS_CLASS=FI24

# ── Optional ─────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
LOOKAHEAD_DAYS=3
